+app/main.py::chat sends to the model for a question, without starting the
+server or calling the model. Regenerate it if that handler changes."""
+
+from types import SimpleNamespace
+
+from app.main import build_messages, rag_config, retrieve
+
+
+def render(question: str) -> list[dict]:
+    req = SimpleNamespace(question=question)
+    cfg = rag_config()
+    chunks = retrieve(req.question, top_k=cfg["retrieval"]["top_k"])
+    messages = build_messages(req.question, chunks, cfg["retrieval"]["max_context_chars"])
+    return messages
